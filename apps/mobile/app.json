{
  "expo": {
    "name": "NutriTime",
    "slug": "nutritime",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "scheme": "nutritime",
    "android": {
      "package": "com.zensoku.nutritime",
      "versionCode": 1000001,
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AppleColorEmoji.ttf",
            "./assets/fonts/CupertinoIcons.ttf",
            "./assets/fonts/ICDIN-Bold.ttf",
            "./assets/fonts/MaterialIcons-Regular.otf",
            "./assets/fonts/Quicksand-Bold.ttf",
            "./assets/fonts/sficons.ttf"
          ]
        }
      ],
      "./plugins/with-shared-debug-keystore",
      "expo-splash-screen"
    ]
  }
}
